# Terraform state files — contain sensitive data, never commit
terraform.tfstate
terraform.tfstate.backup
*.tfstate
*.tfstate.*

# Variable files with real values — contain secrets
terraform.tfvars
*.tfvars
!*.tfvars.example

# Terraform working directory
.terraform/
.terraform.lock.hcl

# Crash logs
crash.log
crash.*.log

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json
