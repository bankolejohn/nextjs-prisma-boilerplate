# Copy this file to terraform.tfvars and fill in your values
# terraform.tfvars is gitignored — never commit it

aws_region     = "us-east-1"
project_name   = "npb"
environment    = "prod"
instance_type  = "t3.small"
volume_size_gb = 20

# Path to your SSH public key (generate from your .pem if needed)
# openssl rsa -in ~/.ssh/npb-prod-key.pem -pubout | ssh-keygen -f /dev/stdin -i -m PKCS8 > ~/.ssh/npb-prod-key.pub
# OR: ssh-keygen -y -f ~/.ssh/npb-prod-key.pem > ~/.ssh/npb-prod-key.pub
ssh_public_key_path = "~/.ssh/npb-prod-key.pub"

# Restrict SSH to your IP only — find it at: curl ifconfig.me
allowed_ssh_cidr = "YOUR_IP_ADDRESS/32"

vpc_cidr           = "10.0.0.0/16"
public_subnet_cidr = "10.0.1.0/24"
